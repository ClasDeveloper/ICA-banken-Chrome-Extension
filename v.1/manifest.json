{
  "name": "ICA Banken budget",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://*.icabanken.se/*"]
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["sheets.js"],
      "run_at": "document_idle"
    }
  ]
}
